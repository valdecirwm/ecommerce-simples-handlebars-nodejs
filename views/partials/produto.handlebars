<div class="produto-card">
  <img src="{{this.image}}" alt="{{this.nome}}">
  <h3>{{this.nome}}</h3>
  <p class="categoria">Categoria: {{this.categoria}}</p>
  <p class="descricao">{{this.descricao}}</p>
  <p class="valor">R$ {{this.valor}}</p>
  <a href="/product/{{this.id}}" class="btn-detalhes">Ver detalhes</a>
</div>