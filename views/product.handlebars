<H2>Página do Produto</H2>

<div class="produto-detalhe">
    <a href="/" class="btn-voltar">&larr; Voltar para a loja</a>
    
    <div class="detalhe-conteudo">
        <img src="{{product.image}}" alt="{{product.nome}}">
        <div class="info">
            <h1>{{product.nome}}</h1>
            <span class="badge">{{product.categoria}}</span>
            <p class="descricao-longa">{{product.descricao}}</p>
            <h2 class="preco">R$ {{product.valor}}</h2>
            <button class="btn-comprar">Comprar agora</button>
        </div>
    </div>
</div>